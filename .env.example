# 管理端旧接口（/getInfo、/getRouters、/system、/monitor 等若依原生接口）baseURL
# 本地开发: /dev-api（Vite 代理到 VITE_API_TARGET）；生产/服务器: /prod-api（Caddy 去前缀转发到后端）
VITE_APP_ADMIN_BASE_API=/dev-api

# PC/APP 新接口（/api/v1/...）baseURL
# 本地开发: /dev-api（Vite 代理到 VITE_API_TARGET）；生产/服务器: /api/v1（Caddy 原样转发到后端）
VITE_APP_PC_BASE_API=/dev-api

# 兼容旧配置（两个请求实例均回退到该值），新配置优先
VITE_APP_BASE_API=/dev-api

# 前端代理目标（本机 RuoYi Spring Boot）
VITE_API_TARGET=http://localhost:8080
